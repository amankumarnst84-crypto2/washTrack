{
  "name": "washtrack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "npm --prefix server start",
    "db:setup": "npm --prefix server run db:generate && npm --prefix server run db:migrate && npm --prefix server run db:seed",
    "start": "npm run build && npm run server",
    "dev:client": "vite",
    "postinstall": "npm ci --prefix server && npm --prefix server run db:generate"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.6"
  }
}
